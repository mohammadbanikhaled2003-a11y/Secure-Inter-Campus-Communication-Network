# Environment configuration for Secure Inter-Campus Network Lab
# Copy this file to .env and configure your group number
# Default template uses group 01 (can be updated at any time)

GROUP_ID=01
GROUP_NUM=1

# Network Definitions:
# HQ LAN:     10.${GROUP_NUM}.1.0/24
# Branch LAN: 10.${GROUP_NUM}.2.0/24
# WAN:        172.16.${GROUP_NUM}.0/24

# Node IPs:
# gw-hq:     172.16.${GROUP_NUM}.10 (WAN), 10.${GROUP_NUM}.1.1 (HQ LAN)
# gw-branch: 172.16.${GROUP_NUM}.20 (WAN), 10.${GROUP_NUM}.2.1 (Branch LAN)
# web-hq:    10.${GROUP_NUM}.1.10
# kdc:       10.${GROUP_NUM}.1.20
# client-br: 10.${GROUP_NUM}.2.10
# attacker:  172.16.${GROUP_NUM}.66 (WAN)

# Domain Names:
# portal.g${GROUP_ID}.scp.lab
# pki.g${GROUP_ID}.scp.lab
# gw-hq.g${GROUP_ID}.scp.lab
# gw-branch.g${GROUP_ID}.scp.lab
